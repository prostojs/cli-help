{
    "name": "@prostojs/cli-help",
    "version": "0.0.11",
    "description": "CLI Help Renderer",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rollup -c rollup.config.js",
        "release": "node ./scripts/release.js",
        "test": "jest --runInBand",
        "test:cov": "jest --runInBand --coverage",
        "lint": "eslint --ext .ts src/**.ts --fix",
        "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
        "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/prostojs/cli-help.git"
    },
    "keywords": [
        "cli-help",
        "prostojs"
    ],
    "buildOptions": {
        "name": "Prostocli-help",
        "formats": [
            "esm-bundler",
            "cjs"
        ]
    },
    "gitHooks": {
        "commit-msg": "node scripts/verifyCommit.js"
    },
    "author": "Artem Maltsev",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/prostojs/cli-help/issues"
    },
    "homepage": "https://github.com/prostojs/cli-help#readme",
    "devDependencies": {
        "@prostojs/dye": "^0.5.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.7.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "conventional-changelog": "^7.2.0",
        "conventional-changelog-cli": "^5.0.0",
        "enquirer": "^2.4.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "execa": "^9.6.1",
        "jest": "^30.4.2",
        "minimist": "^1.2.8",
        "rollup": "^4.60.3",
        "rollup-plugin-dts": "^6.4.1",
        "rollup-plugin-typescript2": "^0.37.0",
        "semver": "^7.8.0",
        "ts-jest": "^29.4.9",
        "typescript": "^5.9.3",
        "yorkie": "^2.0.0"
    }
}
